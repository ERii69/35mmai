# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- App URLs (Pro + Stripe redirects) ---
# Base URL of this Next app (no trailing slash). Use http://localhost:3001 with `npm run dev:pro` (localhost only).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Supabase (Auth + Postgres + RLS) ---
# Project Settings → API → "Publishable and secret API keys" (or Legacy anon / service_role).
NEXT_PUBLIC_SUPABASE_URL=
# Paste Supabase **Publishable** key here (e.g. sb_publishable_…). Same row as "Publishable" in the dashboard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Paste Supabase **default Secret** key here (e.g. sb_secret_…). Server-only — never expose to the client or NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (USD subscription for 35mmAiPro) ---
# Dashboard → Developers → API keys (use test keys locally)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → signing secret (Dashboard endpoint), or from `stripe listen` locally
STRIPE_WEBHOOK_SECRET=
# Product → Price (recurring, USD monthly) — paste Price ID (price_…)
STRIPE_PRICE_ID_PRO_MONTHLY=

# --- Soft launch (invite link only) ---
# Set to 1 for private beta: /pro hides public trial; Checkout requires a valid invite cookie.
PRO_INVITE_ONLY=1
# Comma-separated one-time-style codes (reuse OK until you remove a code). Generate with:
#   node scripts/generate-pro-invite-codes.mjs
# Invite URL shape: {NEXT_PUBLIC_APP_URL}/pro/invite/CODE
PRO_INVITE_CODES=film01-REPLACE,film02-REPLACE,film03-REPLACE,film04-REPLACE,film05-REPLACE,film06-REPLACE,film07-REPLACE,film08-REPLACE,film09-REPLACE,film10-REPLACE

# --- Anthropic (Phase 2 — native Director's Agent) ---
# Soft launch recommendation: leave UNSET so prep stays local ($0 AI).
# Server-only. When unset, workspace falls back to manual copy/paste / local quick prep.
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=

# Optional waitlist webhook (Zapier / Make / Slack) for /pro invite-only panel
PRO_WAITLIST_WEBHOOK_URL=
