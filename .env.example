# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- App URLs (Pro + Stripe redirects) ---
# Base URL of this Next app (no trailing slash). Use http://localhost:3001 with `npm run dev:pro` (localhost only).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Supabase (Auth + Postgres + RLS) ---
# Project Settings → API → "Publishable and secret API keys" (or Legacy anon / service_role).
NEXT_PUBLIC_SUPABASE_URL=
# Paste Supabase **Publishable** key here (e.g. sb_publishable_…). Same row as "Publishable" in the dashboard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Paste Supabase **default Secret** key here (e.g. sb_secret_…). Server-only — never expose to the client or NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (USD subscription for 35mmAiPro) ---
# Dashboard → Developers → API keys (use test keys locally)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → signing secret (Dashboard endpoint), or from `stripe listen` locally
STRIPE_WEBHOOK_SECRET=
# Product → Price (recurring, USD monthly) — paste Price ID (price_…)
STRIPE_PRICE_ID_PRO_MONTHLY=

# --- Soft launch (invite link only) ---
# Set to 1 for private beta: /pro hides public trial; requires invite cookie when Checkout is on.
PRO_INVITE_ONLY=1
# Comma-separated codes. Generate with: node scripts/generate-pro-invite-codes.mjs
# Invite URL: {NEXT_PUBLIC_APP_URL}/pro/invite/CODE
PRO_INVITE_CODES=film01-REPLACE,film02-REPLACE,film03-REPLACE,film04-REPLACE,film05-REPLACE,film06-REPLACE,film07-REPLACE,film08-REPLACE,film09-REPLACE,film10-REPLACE
# Phase 1–4: 0 = hide Subscribe / block startProCheckout (entitle via invite allowlist).
# Live public: 1
PRO_PUBLIC_CHECKOUT=0
# Stripe Checkout trial days when public checkout is on. Soft launch ignores this (Checkout off).
# Default 7. Set 0 for pay-from-day-one (marketing CTAs follow automatically).
# Use NEXT_PUBLIC_ so client marketing matches Stripe Checkout.
NEXT_PUBLIC_PRO_SUBSCRIPTION_TRIAL_DAYS=7
# Optional server-only fallback if NEXT_PUBLIC_ is unset:
# PRO_SUBSCRIPTION_TRIAL_DAYS=7

# --- Anthropic / native Director agents (Phase 5 — enable only after quotas) ---
# Soft launch: PRO_AGENTS_ENABLED=0 (or unset) → local quick prep only, even if a key exists.
# On: PRO_AGENTS_ENABLED=1 AND ANTHROPIC_API_KEY set. Unset key or flag off → no cloud AI.
PRO_AGENTS_ENABLED=0
# Server-only. Required with PRO_AGENTS_ENABLED=1 for native agents.
ANTHROPIC_API_KEY=
# Optional model override. Default (code): claude-3-5-haiku-20241022 (cheaper beta).
# Quality later: claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Redis-less AI quotas (Supabase pro_ai_quota). Apply migration 20260720000007_pro_ai_quota.sql first.
PRO_AI_QUOTA_DAILY=3
PRO_AI_QUOTA_MONTHLY=20

# Private-beta request notifications. Requests are always stored in Supabase first.
# Resend is optional for local development, but all three are required for email notifications.
RESEND_API_KEY=
PRO_WAITLIST_NOTIFY_EMAIL=
# Example after verifying your sending domain: 35mmAiPro <access@35mmai.com>
PRO_WAITLIST_FROM_EMAIL=
