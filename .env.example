# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- App URLs (Pro + Stripe redirects) ---
# Base URL of this Next app (no trailing slash). Use http://localhost:3001 if you use `npm run dev:pro`.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Supabase (Auth + Postgres + RLS) ---
# Project Settings → API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server-only (webhooks, admin). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (USD subscription for 35mmPRO) ---
# Dashboard → Developers → API keys (use test keys locally)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → signing secret (or from `stripe listen` output locally)
STRIPE_WEBHOOK_SECRET=
# Product → Price (recurring, USD monthly) — paste Price ID (price_…)
STRIPE_PRICE_ID_PRO_MONTHLY=
